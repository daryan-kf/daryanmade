# Public canonical site origin (Vercel).
NEXT_PUBLIC_SITE_URL=https://daryanmade.com

# Vercel server-only settings. Use the production Convex HTTP URL, not .convex.cloud.
CONVEX_SITE_URL=https://your-production-deployment.convex.site
SHIELD_API_SECRET=

# Convex deployment environment: configure through the Convex dashboard or CLI.
# SHIELD_API_SECRET must match Vercel. Generate independent secrets of 32+ characters.
SHIELD_TOKEN_SECRET=
RESEND_API_KEY=
SHIELD_EMAIL_FROM="Shield Family <kidshield@daryanmade.com>"
SHIELD_EMAIL_REPLY_TO=info@sarpoli.com
SHIELD_EMAIL_SENDER_VERIFIED=false
SHIELD_SITE_URL=https://daryanmade.com

# Independent app-news lists. This API secret is shared between Vercel and Convex.
# Keep these distinct from the existing Shield offer secrets above.
APP_UPDATES_API_SECRET=
# Convex only: independent signing secret (32+ characters), shared public origin.
APP_UPDATES_TOKEN_SECRET=
APP_UPDATES_SITE_URL=https://daryanmade.com

# Convex only: independent sender identities on the same verified domain.
# Reuse RESEND_API_KEY above. Enable each sender after its domain is verified.
VELA_EMAIL_FROM="Vela <vela@daryanmade.com>"
VELA_EMAIL_REPLY_TO=info@sarpoli.com
VELA_EMAIL_SENDER_VERIFIED=false
IQRA_EMAIL_FROM="Iqra <iqra@daryanmade.com>"
IQRA_EMAIL_REPLY_TO=info@sarpoli.com
IQRA_EMAIL_SENDER_VERIFIED=false
SHIELD_UPDATES_EMAIL_FROM="Shield Family <shield-updates@daryanmade.com>"
SHIELD_UPDATES_EMAIL_REPLY_TO=info@sarpoli.com
SHIELD_UPDATES_EMAIL_SENDER_VERIFIED=false

# `npx convex dev` adds its development deployment selection to .env.local.
# Keep all filled environment files and Apple offer-code batches out of Git.
